+// dspico-romm: HOST_INT_STATUS (0x400) .. RX_LOOKAHEAD0 (0x408..0x40B) in one
+// byte-mode CMD53, like Linux's ath6kl reads its irq_proc_registers. The
+// controller block length must equal the byte count for one transfer.
+// out[0] = HOST/CPU/ERROR/COUNTER_INT_STATUS, out[1] = MBOX_FRAME,
+// RX_LOOKAHEAD_VALID, ..., out[2] = RX_LOOKAHEAD0. Returns false on errors.
+static bool wifi_card_read_irq_regs(u32 out[3])
+{
+    wlan_ctx.tmio.buffer = wifi_card_alignedbuf_small;
+    wlan_ctx.tmio.size = 12;
+    wlan_ctx.tmio.break_early = true;
+
+    u32 old_blocksize = wlan_ctx.tmio.block_size;
+    wlan_ctx.tmio.block_size = 12;
+    wifi_card_send_command_alt(cmd53_read_single,
+            (1u << 28) | (1 << 26) | (F1_HOST_INT_STATUS & 0x1FFFF) << 9 | 12);
+    wlan_ctx.tmio.block_size = old_blocksize;
+
+    if (wlan_ctx.tmio.status & 4)
+        return false;
+    out[0] = wifi_card_alignedbuf_small[0];
+    out[1] = wifi_card_alignedbuf_small[1];
+    out[2] = wifi_card_alignedbuf_small[2];
+    if (WifiData)
+        WifiData->a7_info[DSPICO_A7I_REGS53]++;
+    return true;
+}
