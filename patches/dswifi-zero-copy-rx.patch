+// dspico-romm: zero-copy RX. The pbuf references the frame inside the RX
+// ring; the ring space is given back to the ARM7 when lwIP frees the pbuf.
+static struct pbuf_custom dswifi_rx_ref[WIFI_RXQ_SLOTS];
+
+static void dswifi_rx_ref_free(struct pbuf *p)
+{
+    struct pbuf_custom *pc = (struct pbuf_custom *)p;
+    Wifi_RxRelease(pc - dswifi_rx_ref);
+}
+
+bool dswifi_rx_is_ref(const void *p)
+{
+    const struct pbuf_custom *pc = p;
+    return pc >= &dswifi_rx_ref[0] && pc < &dswifi_rx_ref[WIFI_RXQ_SLOTS];
+}
+
+int dswifi_rx_ref_count(int slot)
+{
+    return dswifi_rx_ref[slot].pbuf.ref;
+}
+
+bool dswifi_send_ref_to_lwip(void *frame, u32 len, int slot)
+{
+    struct pbuf_custom *pc = &dswifi_rx_ref[slot];
+    pc->custom_free_function = dswifi_rx_ref_free;
+
+    struct pbuf *p = pbuf_alloced_custom(PBUF_RAW, len, PBUF_REF, pc, frame, len);
+    if (!p)
+        return false;
+
+    // From here on the slot is released by dswifi_rx_ref_free(), also when
+    // the input function fails and we free the pbuf ourselves.
+    if (dswifi_netif.input(p, &dswifi_netif) != ERR_OK)
+        pbuf_free(p);
+    return true;
+}
