+// dspico-romm: zero-copy RX. A pbuf that references the RX ring and sits in
+// a mailbox nobody reads (e.g. a TLS close_notify on an idle keep-alive
+// socket) would block the ring forever, because ring space is returned in
+// order. Replace such pbufs with copies in normal RAM. Only mailbox entries
+// that are themselves one of our reference pbufs are touched (other entries
+// can be messages or markers, not pbufs). Mailboxes holding more than
+// max_entries messages are skipped: those belong to a socket that is being
+// read (a download), whose data will be released soon anyway; an idle
+// socket typically holds one or two (close_notify, FIN). Returns the number
+// of pbufs replaced.
+int dswifi_rx_migrate_mboxes(size_t max_entries)
+{
+    int moved = 0;
+    for (int i = 0; i < MBOX_NUMBER; i++)
+    {
+        sys_mbox_internal *m = dswifi_mbox[i];
+        if (m == NULL)
+            continue;
+        size_t queued = (m->in_ptr + m->size - m->out_ptr) % m->size;
+        if (queued > max_entries)
+            continue;
+        for (size_t k = m->out_ptr; k != m->in_ptr; k = (k + 1 == m->size) ? 0 : k + 1)
+        {
+            struct pbuf *p = (struct pbuf *)m->arr[k];
+            if (!dswifi_rx_is_ref(p))
+                continue;
+            struct pbuf *q = pbuf_clone(PBUF_RAW, PBUF_RAM, p);
+            if (q == NULL)
+                return moved; // Out of memory: try again later
+            m->arr[k] = (uintptr_t)q;
+            pbuf_free(p); // Releases the ring entries of the whole chain
+            moved++;
+        }
+    }
+    return moved;
+}
