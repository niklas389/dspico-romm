+// dspico-romm: zero-copy RX bookkeeping.
+//
+// lwIP keeps pbufs that point into the RX ring until the data has been read,
+// so the ring position the ARM7 may reuse (WifiData->rxbufRead) is advanced
+// only over packets that have been released, in ring order. Packets that are
+// not handed to lwIP are released immediately. Everything runs in cothreads,
+// so no locking is needed.
+bool dswifi_rx_zero_copy = true;
+int wifi_rx_cur_slot = -1;
+bool wifi_rx_cur_taken;
+
+typedef struct {
+    u32 start;    // Ring index of the entry (size word)
+    u32 end;      // End of the entry (32-byte aligned)
+    u32 next;     // rxbufRead value once this entry is released
+    bool done;
+} rxq_entry;
+
+static rxq_entry rxq[WIFI_RXQ_SLOTS];
+static unsigned int rxq_head, rxq_count;
+static u32 rx_parse_idx;
+
+void Wifi_RxRelease(int slot)
+{
+    rxq[slot].done = true;
+
+    u8 *ring = (u8 *)memCached((void *)WifiData->rxbufData);
+
+    while (rxq_count > 0 && rxq[rxq_head].done)
+    {
+        rxq_entry *e = &rxq[rxq_head];
+        // Discard anything lwIP may have written into the cached frame, so
+        // that no dirty line is written back after the ARM7 reuses it.
+        DC_InvalidateRange(ring + e->start, e->end - e->start);
+        WifiData->rxbufRead = e->next;
+        rxq_head = (rxq_head + 1) % WIFI_RXQ_SLOTS;
+        rxq_count--;
+    }
+}
