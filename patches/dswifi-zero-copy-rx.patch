+// dspico-romm: zero-copy RX bookkeeping.
+//
+// lwIP keeps pbufs that point into the RX ring until the data has been read,
+// so the ring position the ARM7 may reuse (WifiData->rxbufRead) is advanced
+// only over packets that have been released, in ring order. Packets that are
+// not handed to lwIP are released immediately. Everything runs in cothreads,
+// so no locking is needed.
+bool dswifi_rx_zero_copy = true;
+int wifi_rx_cur_slot = -1;
+bool wifi_rx_cur_taken;
+
+typedef struct {
+    u32 start;    // Ring index of the entry (size word)
+    u32 end;      // End of the entry (32-byte aligned)
+    u32 next;     // rxbufRead value once this entry is released
+    u32 t_ms;     // When it was parsed (diagnostics)
+    bool done;
+    bool taken;   // Handed to lwIP as a reference pbuf
+} rxq_entry;
+
+static rxq_entry rxq[WIFI_RXQ_SLOTS];
+static u32 rxq_used_bytes(void);
+static unsigned int rxq_head, rxq_count;
+static u32 rx_parse_idx;
+
+// Diagnostics
+static u32 rxd_zc, rxd_copy, rxd_max_count, rxd_max_bytes, rxd_qfull, rxd_migrated;
+static u32 rx_last_migrate_ms;
+
+#include "lwip/sys.h"
+
+static u32 rxq_used_bytes(void)
+{
+    u32 r = WifiData->rxbufRead, p = rx_parse_idx;
+    return p >= r ? p - r : WIFI_RXBUFFER_SIZE - r + p;
+}
+
+static u32 be16(const u8 *p) { return (p[0] << 8) | p[1]; }
+static u32 be32(const u8 *p) { return (be16(p) << 16) | be16(p + 2); }
+
+int dswifi_rx_debug(char *buf, int len)
+{
+    u8 *ring = (u8 *)memCached((void *)WifiData->rxbufData);
+    int n = snprintf(buf, len,
+                     "rxq count %u used %lu B (max %lu / %lu B) qfull %lu\n"
+                     "rxq zc %lu copy %lu migrated %lu rd %lu parse %lu wr %lu\n",
+                     rxq_count, (unsigned long)(rxq_count ? rxq_used_bytes() : 0),
+                     (unsigned long)rxd_max_count, (unsigned long)rxd_max_bytes,
+                     (unsigned long)rxd_qfull, (unsigned long)rxd_zc,
+                     (unsigned long)rxd_copy, (unsigned long)rxd_migrated,
+                     (unsigned long)WifiData->rxbufRead,
+                     (unsigned long)rx_parse_idx, (unsigned long)WifiData->rxbufWrite);
+
+    // The oldest entries still held, with what they contain
+    unsigned int shown = 0, done_behind = 0;
+    for (unsigned int i = 0; i < rxq_count && n < len; i++)
+    {
+        rxq_entry *e = &rxq[(rxq_head + i) % WIFI_RXQ_SLOTS];
+        if (e->done)
+        {
+            done_behind++;
+            continue;
+        }
+        if (shown++ >= 4)
+            continue;
+        const u8 *f = ring + e->start + 4 + 24 - 14; // Ethernet frame
+        u32 etype = be16(f + 12);
+        const u8 *ip = f + 14;
+        n += snprintf(buf + n, len - n, " held #%u age %lu ms ref %d type %04lx",
+                      i, (unsigned long)(sys_now() - e->t_ms),
+                      e->taken ? dswifi_rx_ref_count((rxq_head + i) % WIFI_RXQ_SLOTS) : -1,
+                      (unsigned long)etype);
+        if (etype == 0x0800 && n < len)
+        {
+            u32 ihl = (ip[0] & 15) * 4, proto = ip[9], tot = be16(ip + 2);
+            n += snprintf(buf + n, len - n, " ip p%lu len %lu frag %04lx",
+                          (unsigned long)proto, (unsigned long)tot,
+                          (unsigned long)be16(ip + 6));
+            if (proto == 6 && n < len)
+            {
+                const u8 *t = ip + ihl;
+                u32 thl = (t[12] >> 4) * 4;
+                n += snprintf(buf + n, len - n, " tcp %lu>%lu seq %lu fl %02x data %ld",
+                              (unsigned long)be16(t), (unsigned long)be16(t + 2),
+                              (unsigned long)be32(t + 4), t[13],
+                              (long)tot - (long)ihl - (long)thl);
+            }
+        }
+        if (n < len)
+            n += snprintf(buf + n, len - n, "\n");
+    }
+    if (n < len)
+        n += snprintf(buf + n, len - n, "rxq held %u, released behind head %u\n",
+                      shown, done_behind);
+    return n;
+}
+
+void Wifi_RxRelease(int slot)
+{
+    rxq[slot].done = true;
+
+    u8 *ring = (u8 *)memCached((void *)WifiData->rxbufData);
+
+    while (rxq_count > 0 && rxq[rxq_head].done)
+    {
+        rxq_entry *e = &rxq[rxq_head];
+        // Discard anything lwIP may have written into the cached frame, so
+        // that no dirty line is written back after the ARM7 reuses it.
+        DC_InvalidateRange(ring + e->start, e->end - e->start);
+        WifiData->rxbufRead = e->next;
+        rxq_head = (rxq_head + 1) % WIFI_RXQ_SLOTS;
+        rxq_count--;
+    }
+}
