+// dspico-romm: SDIO-level reset (CCCR I/O Abort, RES bit). The card drops
+// back to its idle state, so the next init runs the full CMD5/CMD3/CMD7
+// sequence instead of skipping it, and the mailbox side is reset too.
+void dspico_card_sdio_reset(void)
+{
+    wifi_card_write_func0_u8(0x6, 0x8);
+    ioDelay(0xF000);
+    if (WifiData)
+        WifiData->a7_diag[DSPICO_A7D_INIT_RESTARTS] += 0x100; // SDIO resets
+}
+
+// dspico-romm: counts packets while the card initializes (diagnostics)
+static void dspico_init_pkt(u32 header, int kind)
+{
+    if (!WifiData || WifiData->curMode != WIFIMODE_INITIALIZING)
+        return;
+    volatile u32 *d = WifiData->a7_diag;
+    if (d[DSPICO_A7D_INIT_PKTS] == 0 && d[DSPICO_A7D_FIRST_HDR] == 0)
+        d[DSPICO_A7D_FIRST_HDR] = header;
+    d[DSPICO_A7D_LAST_HDR] = header;
+    u32 v = d[DSPICO_A7D_INIT_PKTS];
+    u32 c = (v >> (8 * kind)) & 0xFF;
+    if (c < 0xFF)
+        d[DSPICO_A7D_INIT_PKTS] = v + (1u << (8 * kind));
+}
