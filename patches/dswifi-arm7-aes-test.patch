+// SPDX-License-Identifier: MIT
+//
+// dspico-romm: DSi AES engine test (speed test of the app, source/aesbench.c).
+// The ARM9 sends the address of a job (FIFO_USER_07); the ARM7 runs AES-CTR
+// over the job's buffer with the hardware and sets job->done. Only the ARM7
+// can reach the AES engine. Uses key slot 1 (libnds uses slot 3 for NAND)
+// and NDMA channels 0/1 (DSWiFi uses channel 3).
+
+#include <string.h>
+
+#include <nds.h>
+#include <nds/arm7/aes.h>
+
+// Must match aes_job_t in the app (source/aesbench.c)
+typedef struct
+{
+    u8 key[16];
+    u8 iv[16];
+    u32 cnt_extra;      // OR-ed into REG_AES_CNT (word order bits 22/23, ...)
+    u32 flags;          // 1: reverse key bytes, 2: reverse IV bytes, 4: NDMA
+    const u32 *src;
+    u32 *dst;
+    u32 blocks;         // 16-byte blocks; NDMA: multiple of 4
+    u32 lines;          // ARM7 time in scanlines (63.56 us), for the log
+    volatile u32 done;  // 1 = ok, 2 = timeout
+} aes_job_t;
+
+#define AES_TEST_KEYSLOT 1
+#define NDMA_IN  0
+#define NDMA_OUT 1
+
+static u32 aes_fifo_words_in(void)
+{
+    return REG_AES_CNT & 0x1F;
+}
+
+static u32 aes_fifo_words_out(void)
+{
+    return (REG_AES_CNT >> 5) & 0x1F;
+}
+
+static void aes_test_run(aes_job_t *job)
+{
+    u32 v0 = REG_VCOUNT, lines = 0;
+
+    // Key into slot 1 (normal key), IV
+    for (int i = 0; i < 16; i++)
+        AES_KEYSLOT[AES_TEST_KEYSLOT].normalkey[i] =
+            job->key[(job->flags & 1) ? 15 - i : i];
+    for (int i = 0; i < 16; i++)
+        REG_AES_IV[i] = job->iv[(job->flags & 2) ? 15 - i : i];
+
+    REG_AES_CNT = AES_WRFIFO_FLUSH | AES_RDFIFO_FLUSH;
+    REG_AES_BLKCNT = job->blocks << 16;
+
+    const u32 *src = job->src;
+    u32 *dst = job->dst;
+    u32 words = job->blocks * 4;
+    u32 timeout = 4000000;
+
+    if (job->flags & 4)
+    {
+        // NDMA: 16 words per request in both directions
+        REG_NDMA_CR(NDMA_IN) = 0;
+        REG_NDMA_CR(NDMA_OUT) = 0;
+        REG_NDMA_SRC(NDMA_IN) = (u32)src;
+        REG_NDMA_DEST(NDMA_IN) = (u32)&REG_AES_WRFIFO;
+        REG_NDMA_LENGTH(NDMA_IN) = words;
+        REG_NDMA_BLENGTH(NDMA_IN) = 16;
+        REG_NDMA_SRC(NDMA_OUT) = (u32)&REG_AES_RDFIFO;
+        REG_NDMA_DEST(NDMA_OUT) = (u32)dst;
+        REG_NDMA_LENGTH(NDMA_OUT) = words;
+        REG_NDMA_BLENGTH(NDMA_OUT) = 16;
+        REG_NDMA_CR(NDMA_OUT) = NDMA_ENABLE | NDMA_START_AES_OUT | NDMA_SRC_FIX |
+                                NDMA_DST_INC | NDMA_BLOCK_SCALER(4);
+        REG_NDMA_CR(NDMA_IN) = NDMA_ENABLE | NDMA_START_AES_IN | NDMA_SRC_INC |
+                               NDMA_DST_FIX | NDMA_BLOCK_SCALER(4);
+
+        REG_AES_CNT = AES_CNT_MODE(2) | AES_CNT_KEYSLOT(AES_TEST_KEYSLOT) |
+                      AES_CNT_KEY_APPLY | AES_CNT_DMA_WRITE_SIZE(0) |
+                      AES_CNT_DMA_READ_SIZE(3) | job->cnt_extra | AES_CNT_ENABLE;
+
+        while ((REG_NDMA_CR(NDMA_OUT) & NDMA_BUSY) && --timeout)
+            ;
+        REG_NDMA_CR(NDMA_IN) = 0;
+        REG_NDMA_CR(NDMA_OUT) = 0;
+    }
+    else
+    {
+        REG_AES_CNT = AES_CNT_MODE(2) | AES_CNT_KEYSLOT(AES_TEST_KEYSLOT) |
+                      AES_CNT_KEY_APPLY | job->cnt_extra | AES_CNT_ENABLE;
+
+        // CPU: keep the input FIFO filled, drain the output FIFO
+        u32 in = 0, out = 0;
+        while (out < words && --timeout)
+        {
+            while (in < words && aes_fifo_words_in() <= 12)
+            {
+                REG_AES_WRFIFO = src[in++];
+                REG_AES_WRFIFO = src[in++];
+                REG_AES_WRFIFO = src[in++];
+                REG_AES_WRFIFO = src[in++];
+            }
+            while (aes_fifo_words_out() >= 4)
+            {
+                dst[out++] = REG_AES_RDFIFO;
+                dst[out++] = REG_AES_RDFIFO;
+                dst[out++] = REG_AES_RDFIFO;
+                dst[out++] = REG_AES_RDFIFO;
+            }
+        }
+    }
+
+    lines = (REG_VCOUNT + 263 - v0) % 263; // Only valid below one frame
+    job->lines = lines;
+    REG_AES_CNT = 0;
+    job->done = timeout ? 1 : 2;
+}
+
+static void aes_test_handler(void *address, void *userdata)
+{
+    (void)userdata;
+    aes_test_run(address);
+}
+
+void dspico_aes_test_install(void)
+{
+    fifoSetAddressHandler(FIFO_USER_07, aes_test_handler, 0);
+}
