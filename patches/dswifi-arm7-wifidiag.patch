diff --git a/source/common/wifi_shared.h b/source/common/wifi_shared.h
index 93a99ed..9ac3626 100644
--- a/source/common/wifi_shared.h
+++ b/source/common/wifi_shared.h
@@ -289,6 +289,8 @@ typedef struct WIFI_MAINSTRUCT
     // about the Wi-Fi firmware and its receive path (DSPICO_A7I_*).
     u32 a7_opts;
     u32 a7_info[16];
+    // dspico-romm: connect diagnostics (DSPICO_A7D_*), counted by the ARM7
+    u32 a7_diag[16];
 
