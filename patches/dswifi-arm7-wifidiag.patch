 } Wifi_MainStruct;
@@ -318,6 +320,26 @@ enum {
     DSPICO_A7I_EAPOL,        // DMA path: EAPOL frames also handled on the ARM7
 };
 
+// dspico-romm: WifiData->a7_diag[] indices (card init and scan stages)
+enum {
+    DSPICO_A7D_SCFG_EXT,     // REG_SCFG_EXT (ARM7) at card init
+    DSPICO_A7D_SCFG_WL,      // SCFG_WL: before | after off << 8 | after on << 16
+    DSPICO_A7D_INIT_FLAGS,   // 1: CMD5 skipped, 2: 1-bit bus; CMD5 loops << 8
+    DSPICO_A7D_FW_UPLOADED,  // Host interest "firmware uploaded" before reset
+    DSPICO_A7D_RESET_CAUSE,  // RESET_CAUSE after the soft reset (expect 2)
+    DSPICO_A7D_WMI_READY,    // WMI_READY_EVENT count
+    DSPICO_A7D_REGDOMAIN,    // WMI_REG_DOMAIN_EVENT count
+    DSPICO_A7D_CHANNELS,     // Channels in the channel list
+    DSPICO_A7D_SCAN_START,   // WMI_START_SCAN_CMD count
+    DSPICO_A7D_SCAN_DONE,    // WMI_SCAN_COMPLETE_EVENT count
+    DSPICO_A7D_BSS,          // WMI_BSS_INFO_EVENT count
+    DSPICO_A7D_BSS_LOWSNR,   // ... of these ignored (SNR < 0x10)
+    DSPICO_A7D_SNR,          // Highest SNR | last SNR << 8
+    DSPICO_A7D_ERRORS,       // CMD_ERROR count | last TARGET_ERROR id << 16
+    DSPICO_A7D_CONN,         // CONNECT count | DISCONNECT << 8 | reason << 16
+    DSPICO_A7D_STARTS,       // Card inits (Wifi_TWL_Start)
+};
