+// dspico-romm: connect diagnostics (DSPICO_A7D_*). out[16] = curMode.
+void Wifi_A7Diag(u32 out[17])
+{
+    for (int i = 0; i < 16; i++)
+        out[i] = WifiData ? WifiData->a7_diag[i] : 0;
+    out[16] = WifiData ? (u32)WifiData->curMode : 0xFF;
+}
