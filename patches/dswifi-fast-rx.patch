+// dspico-romm: header and payload in separate buffers (see rx_tx.c).
+void dswifi_send_eth_to_lwip(const void *hdr, u32 hdr_len, const void *payload, u32 len)
+{
+    struct pbuf *p = pbuf_alloc(PBUF_IP, hdr_len + len, PBUF_POOL);
+    if (!p)
+        return;
+
+    if (pbuf_take(p, hdr, hdr_len) != ERR_OK ||
+        pbuf_take_at(p, payload, len, hdr_len) != ERR_OK)
+    {
+        pbuf_free(p);
+        return;
+    }
+
+    if (dswifi_netif.input(p, &dswifi_netif) != ERR_OK)
+        pbuf_free(p);
+}
+
+// dspico-romm: the MTU decides the TCP MSS lwIP advertises on new connections.
+void dswifi_set_mtu(u16 mtu)
+{
+    dswifi_netif.mtu = mtu;
+}
+
+u16 dswifi_get_mtu(void)
+{
+    return dswifi_netif.mtu;
+}
