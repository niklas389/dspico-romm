diff --git a/source/arm7/twl/rx_queue.twl.c b/source/arm7/twl/rx_queue.twl.c
index 12b92d7..e449109 100644
--- a/source/arm7/twl/rx_queue.twl.c
+++ b/source/arm7/twl/rx_queue.twl.c
@@ -10,6 +10,32 @@
 #include "arm7/twl/card.h"
 #include "common/common_twl_defs.h"
 
+// dspico-romm: the packet data in the mailbox buffer starts at an address
+// = 2 mod 4 and ring entries are word aligned, so memcpy() falls back to
+// byte stores, which are slow on the ARM7's 16-bit main RAM bus (~7 cycles
+// per byte measured). Merge halfwords into words instead.
+static void copy_to_ring(u8 *dst, const u8 *src, size_t n)
+{
+    if ((((uintptr_t)dst & 3) != 0) || (((uintptr_t)src & 3) != 2) || n < 8)
+    {
+        memcpy(dst, src, n);
+        return;
+    }
+
+    size_t words = (n - 2) / 4;   // Whole words that need only aligned reads
+    u32 *d = (u32 *)dst;
+    const u32 *s = (const u32 *)(src + 2);
+    u32 carry = *(const u16 *)src;
+    for (size_t i = 0; i < words; i++)
+    {
+        u32 w = s[i];
+        d[i] = carry | (w << 16);
+        carry = w >> 16;
+    }
+    size_t done = words * 4;
+    memcpy(dst + done, src + done, n - done);
+}
