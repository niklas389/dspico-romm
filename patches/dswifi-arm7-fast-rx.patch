+static void wifi_card_process_pkts(void)
+{
+    if (!wifi_card_fast_path())
+    {
+        wifi_card_process_pkts_upstream();
+        return;
+    }
+
+    // dspico-romm: read the four status bytes with one CMD53 and write back
+    // only the non-zero ones (same values and order as upstream's 32-bit
+    // write, which always cost four CMD52).
+    u32 int_sts = DSPICO_A7_CMD53 ? wifi_card_read_func1_u32_fast(F1_HOST_INT_STATUS)
+                                  : wifi_card_read_func1_u32(F1_HOST_INT_STATUS);
+    for (int b = 3; b >= 0; b--)
