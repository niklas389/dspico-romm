+        if (v)
+            wifi_card_write_func1_u8(F1_HOST_INT_STATUS + b, v);
+    }
+
+    readpkt_irq_mode = true;
+    while (wifi_card_mbox0_readpkt());
+    readpkt_irq_mode = false;
